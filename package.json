{
  "name": "bid-lens",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply bid-lens --local",
    "migrate:remote": "wrangler d1 migrations apply bid-lens --remote"
  },
  "dependencies": {
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/vitest-pool-workers": "^0.8.12",
    "@cloudflare/workers-types": "^4.20250525.0",
    "lefthook": "^1.11.13",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2",
    "wrangler": "^4.87.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "lefthook", "sharp", "workerd"]
  }
}
