{
  "name": "bid-lens",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply bid-lens --local",
    "migrate:remote": "wrangler d1 migrations apply bid-lens --remote"
  },
  "dependencies": {
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  }
}
