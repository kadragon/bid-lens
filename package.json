{
  "name": "bid-lens",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "CI": "pnpm typecheck && pnpm lint && pnpm test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "filter:trial": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/filter-trial.mts",
    "migrate:local": "wrangler d1 migrations apply bid-lens --local",
    "migrate:remote": "wrangler d1 migrations apply bid-lens --remote"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
